# ── Required ──────────────────────────────────────────────────────────
# Shared secret clients send as the X-API-Key header.
# Generate with: openssl rand -hex 32
DRA_API_KEY=

# OpenRouter key. Without it the API accepts only live=false (dry-run) jobs.
OPENROUTER_API_KEY=


# ── Storage ───────────────────────────────────────────────────────────
# Must be a PERSISTENT volume. Job records, run folders, generated
# deliverables and results JSON all live here.
DRA_RUN_ROOT=/data/runs

# Colon-separated roots that client-supplied file paths are confined to.
# Uploads land under $DRA_RUN_ROOT/_uploads and are always allowed.
DRA_INPUT_ROOTS=/data/inputs

# ── Capacity ──────────────────────────────────────────────────────────
# Concurrent JOBS. Each job may itself fan out to several models
# (see the per-request `concurrency` field). 2 jobs x 4 models = 8 live
# model sessions. Size this against RAM and your OpenRouter rate limit.
DRA_MAX_PARALLEL_JOBS=2

# ── Optional ──────────────────────────────────────────────────────────
# Google Drive input resolution. MUST be a service account on a server —
# GOOGLE_CLIENT_SECRETS triggers an interactive browser OAuth flow that
# will hang a headless container. Share the Drive folders with the service
# account's email address.
# GOOGLE_SERVICE_ACCOUNT_KEY=./gcp_key.json

# Better web search than the DuckDuckGo fallback.
# SERPER_API_KEY=
